{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口需要的核心能力：外链打开、保存对话框与文件写入",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": ["$HOME/**", "$DOWNLOAD/**", "$DOCUMENT/**", "$DESKTOP/**"]
    }
  ]
}
