{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ds-chat",
  "version": "0.1.4",
  "identifier": "com.sirilee.dschat",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:8090",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "API 使用 demo",
        "width": 1100,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "android": {
      "minSdkVersion": 24
    }
  }
}
